#include <windows.h>

1 ICON "app.ico"

#define RT_MANIFEST 24
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
 FILEVERSION     1,1,0,0
 PRODUCTVERSION  1,1,0,0
 FILEOS          0x40004L
 FILETYPE        0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription",  "Force Eject USB - force eject removable drives and CD-ROMs"
      VALUE "ProductName",      "ForceEjectUSB"
      VALUE "FileVersion",      "1.1.0.0"
      VALUE "ProductVersion",   "1.1.0.0"
      VALUE "OriginalFilename", "ForceEjectUSB.exe"
      VALUE "LegalCopyright",   "Freeware"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 0x4B0
  END
END
